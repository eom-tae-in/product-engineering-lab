# savePick 백엔드가 읽는 환경변수 목록. 실제 값은 커밋하지 않는다.
#
# Spring Boot는 프론트(Next.js)와 달리 .env 파일을 자동으로 읽지 않는다. 이 파일은 "무엇을
# 넣어야 하는가"의 목록이며, 실제 주입은 다음 중 하나로 한다.
#   - 배포 플랫폼의 환경변수·시크릿 설정 (권장)
#   - 셸에서 직접:  export $(grep -v '^#' .env | grep . | xargs)
#   - docker compose의 env_file

# --- 필수 ---
# 32바이트 이상. 비우면 application.yml의 개발용 기본값이 쓰이는데, 그 값은 저장소에
# 공개돼 있어 dev·test가 아닌 프로파일에서는 JwtSecretGuard가 기동을 거부한다 (12번 §5 P8).
#   생성: openssl rand -base64 48
JWT_SECRET=

# --- 데이터베이스 (기본값은 backend/docker-compose.yml의 로컬 PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=savepick
DB_USERNAME=savepick
DB_PASSWORD=

# --- 서버 ---
SERVER_PORT=8080

# --- 첫 관리자 계정 (12번 §5.1) ---
# 넷 다 비어 있으면 아무 일도 하지 않는다. 계정을 만든 뒤에는 네 값을 지우고 다시 배포한다.
# 일부만 채우거나 형식이 틀리면 AdminBootstrapRunner가 기동을 거부한다.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PHONE=
